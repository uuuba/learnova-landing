# Legacy mode (default): existing landing and Neon subscription table.
# Enable CMS only with a dedicated, migrated database.
PAYLOAD_ENABLED=false
# Optional Neon TLS WebSocket transport for HTTPS-only environments.
NEON_WEBSOCKETS=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST/skill_nova_cms?sslmode=require
PAYLOAD_SECRET=
# Used only for the first seed. Never commit actual values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
